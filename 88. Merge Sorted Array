class Solution {
    public void merge(int[] nums1, int m, int[] nums2, int n) {
        int k=0;
        for(int i=m;i<n;i++){
            nums1[i]=nums2[k];
            k++;
        }
        for(int i:nums2){
            nums1[m++]=i;
        }
        Arrays.sort(nums1);  
    }
}
        

        
