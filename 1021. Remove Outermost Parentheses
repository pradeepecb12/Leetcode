class Solution {
    public String removeOuterParentheses(String s) {
        Stack<Character> stack=new Stack<>();
        StringBuilder out=new StringBuilder();
        for(char ch:s.toCharArray()){
            if(ch =='('){
                if(!stack.isEmpty()){
                    out.append(ch);
                }
                stack.push(ch);
            }else{
                stack.pop();
                if(!stack.isEmpty()){
                    out.append(ch);
                }
            }
        }
        return out.toString();
        
    }
}
