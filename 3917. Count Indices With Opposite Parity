class Solution {
    public int[] countOppositeParity(int[] nums) {
        int n=nums.length;
        int []res=new int[n];
        for(int i=0;i<n;i++){
            int even=0;
            int odd=0;
            for(int j=i+1;j<n;j++){
                if(nums[j]%2!=0){
                    odd++;
                }else{
                    even++;
                }
            }
            if(nums[i]%2==0){
                res[i]=odd;
            }else {
                res[i]=even;
            }
        }
        return res;
    }
}
