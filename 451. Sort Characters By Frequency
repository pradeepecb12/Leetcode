class Solution {
    public String frequencySort(String s) {
        int n=s.length();
        HashMap<Character,Integer> map=new HashMap<>();
        for(char ch:s.toCharArray()){                                     // count freq
            map.put(ch,map.getOrDefault(ch,0)+1);
            
        }
        StringBuilder sb=new StringBuilder();
        List<Map.Entry<Character,Integer>> sorted=new ArrayList<>(map.entrySet());   // storing in list to make order
        sorted.sort((a,b)-> b.getValue()-a.getValue());                          // sorting list by freq

        for(Map.Entry<Character,Integer>entry:sorted){
            for(int i=0;i<entry.getValue();i++){                       //adding repting char based on frequency 
                sb.append(entry.getKey());
            }
        }
        return sb.toString();   
    }
}
