class Solution {
    public int lengthOfLongestSubstring(String s) {
        int n=s.length();
        int count=0;
        int max=count;
        for(int i=0;i<n;i++){
            String temp="";
            for(int j=i;j<n;j++){
                char ch=s.charAt(j);
                if(temp.contains(String.valueOf(ch))){              // brute force solution O(n2);
                    break;
                }
                temp+=ch;
                max=Math.max(max,temp.length());
            }   
        }
        return max; 
    }
}
