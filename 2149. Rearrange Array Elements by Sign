class Solution {
    public int[] rearrangeArray(int[] nums) { 
        int n=nums.length;
        int[]pos=new int[n/2];
        int []negative=new int[n/2];
        int k=0,p=0;
        for(int X:nums){
            if(X>0){
                pos[k++]=X;         // separating positive num
            }else{
                negative[p++]=X;    // sepa negative 
            }
        }
        int kp=0;
        for(int i=0;i<n/2;i++){
            nums[kp++]=pos[i];                  // filling (1)pos+(1)neg in nums array 
            nums[kp++]=negative[i];
        }
        return nums;
    }
}
