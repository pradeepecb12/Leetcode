class Solution {
    public int findKthLargest(int[] nums, int k) {
        Queue<Integer> minList=new PriorityQueue<>();
        int n=nums.length;

        for(int i=0;i<k;i++){

            minList.offer(nums[i]);
            
        }
        for(int i=k;i<n;i++){
            if(nums[i]>minList.peek()){
                minList.poll();
                minList.offer(nums[i]);
            }
        }
        return minList.peek();
        
    }
}
