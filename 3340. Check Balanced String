class Solution {
    public boolean isBalanced(String num) {
        boolean balance=true;
        int evenSum=0;
        int oddSum=0;
        for(int i=0;i<num.length();i++){  
            int x=num.charAt(i)-'0';
            if(i%2==0){
                evenSum+=x;
            }else{
                oddSum+=x;
            }
        }
        return evenSum==oddSum;    
    }
}
