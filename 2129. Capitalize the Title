class Solution {
    public String capitalizeTitle(String title) {
        String []arr=title.split(" ");
        String res="";
        for(String op:arr){
            if(op.length()>2){
                char ch =op.charAt(0);
                res+=Character.toUpperCase(ch);
                for(int i=1;i<op.length();i++){
                    char pet=op.charAt(i);
                    res+=Character.toLowerCase(pet);      
                }
            }else{
                for(int i=0;i<op.length();i++){
                    char ch=op.charAt(i);
                    res+=Character.toLowerCase(ch);
                }
            }
            res+=" ";
        }
        res=res.trim();
        return res; 
    }
}
